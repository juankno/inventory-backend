# Copia este archivo como .env y ajusta los valores (G-06).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"
# Conexión directa para las migraciones de Prisma (prisma.config.ts). En local es la misma.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"
JWT_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"
PORT=3000
# Contraseña de la cuenta de demostración que crea el script de datos semilla.
SEED_DEMO_PASSWORD="Demo1234"
# Correos (RF-04). Proveedor: smtp | resend | console. Vacío: smtp si hay
# SMTP_HOST, resend si hay RESEND_API_KEY y, si no, console (en desarrollo
# escribe el correo en la consola; en producción no envía nada).
EMAIL_PROVIDER=""
# Remitente. Debe ser una dirección que el proveedor te deje usar.
EMAIL_FROM="Surtido <onboarding@resend.dev>"
# Con EMAIL_PROVIDER=smtp sirve cualquier proveedor: cambia solo estos valores.
# Ejemplos en el README (Gmail, Resend, SendGrid, Brevo...).
SMTP_HOST=""
SMTP_PORT=587
# Vacío: TLS directo solo en el puerto 465; en los demás, STARTTLS.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# Solo con EMAIL_PROVIDER=resend (API de Resend).
RESEND_API_KEY=""
