# Copia este archivo como .env y ajusta los valores (G-06).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"
# Conexión directa para las migraciones de Prisma (prisma.config.ts). En local es la misma.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"
JWT_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"
PORT=3000
# Contraseña de la cuenta de demostración que crea el script de datos semilla.
SEED_DEMO_PASSWORD="Demo1234"
# Correos para restablecer la contraseña (RF-04) con Resend. Sin la clave, en
# desarrollo el correo se escribe en la consola; en producción no se envía.
RESEND_API_KEY=""
# Remitente. onboarding@resend.dev solo entrega al correo de tu cuenta de Resend;
# para los demás correos hay que verificar un dominio en Resend y usarlo aquí.
EMAIL_FROM="Surtido <onboarding@resend.dev>"
