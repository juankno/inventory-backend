{
  "framework": null,
  "outputDirectory": "public",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.ts": {
      "includeFiles": "api/openapi.yaml"
    }
  }
}
