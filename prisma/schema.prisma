// Backend data schema — version 1.1, Prisma ORM 7 (DDS v1.1, Apéndice A)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// In Prisma 7 the connection URL is defined in prisma.config.ts
datasource db {
  provider = "postgresql"
}

enum Unit {
  UNIT
  KILOGRAM
  GRAM
  POUND
  LITER
}

enum CodeType {
  GTIN
  INTERNAL
}

enum MovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
}

enum OutboundReason {
  SALE
  CONSUMPTION
  LOSS
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  user     User?
  products Product[]

  @@map("businesses")
}

model User {
  id                   String   @id @default(uuid()) @db.Uuid
  businessId           String   @unique @map("business_id") @db.Uuid
  ownerName            String   @map("owner_name") @db.VarChar(80)
  email                String   @unique @db.VarChar(254)
  passwordHash         String   @map("password_hash")
  dataPolicyAcceptedAt DateTime @map("data_policy_accepted_at")
  createdAt            DateTime @default(now()) @map("created_at")

  business            Business             @relation(fields: [businessId], references: [id])
  movements           Movement[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Product {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String   @db.VarChar(80)
  unit       Unit
  salePrice  Decimal? @map("sale_price") @db.Decimal(12, 2)
  stock      Decimal  @default(0) @db.Decimal(12, 2)
  minStock   Decimal? @map("min_stock") @db.Decimal(12, 2)
  codeType   CodeType @map("code_type")
  code       String   @db.VarChar(32)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id])
  movements Movement[]

  @@unique([businessId, code])
  @@index([businessId, isActive, name])
  @@map("products")
}

model Movement {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  type           MovementType
  reason         OutboundReason?
  quantity       Decimal         @db.Decimal(12, 2)
  resultingStock Decimal         @map("resulting_stock") @db.Decimal(12, 2)
  idempotencyKey String          @unique @map("idempotency_key") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId, createdAt(sort: Desc)])
  @@map("movements")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}
